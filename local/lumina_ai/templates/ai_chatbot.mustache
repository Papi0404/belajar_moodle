{{!
    Lumina LMS — Conversational AI Tutor / ChatGPT-style Floating Assistant
}}
<!-- Lumina AI Floating Action Button -->
<div id="luminaAiFab" class="lumina-ai-fab d-print-none" role="button" aria-label="Tanya Lumina AI" tabindex="0">
    <div class="ai-fab-glow"></div>
    <div class="ai-fab-content">
        <span class="material-symbols-outlined ai-fab-icon">auto_awesome</span>
        <span class="ai-fab-text d-none d-sm-inline">Tanya Lumina AI</span>
    </div>
</div>

<!-- Lumina AI Floating Chat Window -->
<div id="luminaAiChatWindow" class="lumina-ai-chat-window d-print-none" aria-hidden="true">
    <!-- Chat Header -->
    <div class="ai-chat-header">
        <div class="d-flex align-items-center gap-2">
            <div class="ai-avatar-badge">
                <span class="material-symbols-outlined text-[20px]">psychology</span>
            </div>
            <div>
                <div class="ai-title">Lumina AI Academic Tutor</div>
                <div class="ai-status">
                    <span class="ai-status-dot"></span>
                    <span>Online • ChatGPT-Powered Assistant</span>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button id="luminaAiClearBtn" class="ai-icon-btn" type="button" title="Bersihkan Percakapan" aria-label="Clear chat">
                <span class="material-symbols-outlined text-[18px]">delete_sweep</span>
            </button>
            <button id="luminaAiCloseBtn" class="ai-icon-btn" type="button" title="Tutup Chat" aria-label="Close chat">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>
    </div>

    <!-- Chat Messages Container -->
    <div id="luminaAiMessages" class="ai-chat-messages">
        <!-- Initial Welcome Message -->
        <div class="ai-message ai-message-assistant">
            <div class="ai-msg-avatar">
                <span class="material-symbols-outlined text-[18px]">smart_toy</span>
            </div>
            <div class="ai-msg-body">
                <p class="mb-2">Halo! 👋 Saya <strong>Lumina AI</strong>, asisten akademik personal Anda di Lumina LMS. Ada konsep mata kuliah, tugas, kuis, atau koding yang ingin Anda diskusikan?</p>
                
                <div class="ai-prompt-chips">
                    <button type="button" class="ai-chip" data-prompt="Apa saja daftar mata kuliah saya semester ini?">
                        📘 Daftar mata kuliah
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Apakah ada tugas atau kuis dengan tenggat waktu terdekat?">
                        ⏳ Cek tenggat tugas
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Jelaskan konsep dasar Algoritma Binary Search dan contoh kodenya">
                        🧠 Jelaskan Binary Search
                    </button>
                    <button type="button" class="ai-chip" data-prompt="Jelaskan prinsip ACID dalam Sistem Basis Data">
                        🗄️ Prinsip ACID Basis Data
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Typing Indicator (Hidden by default) -->
    <div id="luminaAiTyping" class="ai-typing-indicator d-none">
        <div class="ai-msg-avatar">
            <span class="material-symbols-outlined text-[18px]">smart_toy</span>
        </div>
        <div class="typing-dots">
            <span></span><span></span><span></span>
        </div>
        <span class="small text-muted ms-2">Lumina AI sedang berpikir...</span>
    </div>

    <!-- Chat Input Area -->
    <div class="ai-chat-footer">
        <form id="luminaAiForm" class="ai-input-form m-0" onsubmit="return false;">
            <div class="ai-input-container">
                <textarea id="luminaAiInput" class="ai-textarea" rows="1" placeholder="Tanyakan apa saja ke Lumina AI... (Enter untuk kirim)" required></textarea>
                <button id="luminaAiSendBtn" class="ai-send-btn" type="button" aria-label="Kirim Pesan">
                    <span class="material-symbols-outlined text-[20px]">send</span>
                </button>
            </div>
            <div class="ai-footer-note">
                Tekan <kbd>Enter</kbd> untuk kirim, <kbd>Shift + Enter</kbd> untuk baris baru
            </div>
        </form>
    </div>
</div>

<style>
/* Lumina AI Chatbot Styles */
.lumina-ai-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1040;
    cursor: pointer;
    user-select: none;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.lumina-ai-fab:hover {
    transform: translateY(-3px) scale(1.03);
}
.lumina-ai-fab:active {
    transform: translateY(0) scale(0.97);
}
.ai-fab-glow {
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    background: linear-gradient(135deg, #4338ca, #6366f1, #06b6d4);
    filter: blur(8px);
    opacity: 0.6;
    animation: luminaPulse 3s infinite ease-in-out;
}
@keyframes luminaPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.85; transform: scale(1.04); }
}
.ai-fab-content {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
    color: #ffffff;
    border-radius: 9999px;
    box-shadow: 0 10px 25px -5px rgba(67, 56, 202, 0.5), 0 8px 10px -6px rgba(67, 56, 202, 0.4);
    font-weight: 600;
    font-size: 0.9375rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
}
.ai-fab-icon {
    font-size: 22px;
    color: #38bdf8;
    animation: luminaSparkle 2.5s infinite;
}
@keyframes luminaSparkle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(15deg) scale(1.15); }
}

/* Chat Window */
.lumina-ai-chat-window {
    position: fixed;
    bottom: 90px;
    right: 24px;
    width: 420px;
    height: 600px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 120px);
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.25), 0 0 0 1px rgba(226, 232, 240, 0.8);
    display: flex;
    flex-direction: column;
    z-index: 1045;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.lumina-ai-chat-window.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
}

/* Header */
.ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.ai-avatar-badge {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    border: 1px solid rgba(255, 255, 255, 0.2);
}
.ai-title {
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
}
.ai-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #a5b4fc;
}
.ai-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
}
.ai-icon-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: none;
    color: #c7d2fe;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
}
.ai-icon-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

/* Messages */
.ai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.ai-message {
    display: flex;
    gap: 12px;
    max-width: 90%;
    animation: fadeInMsg 0.25s ease-out;
}
@keyframes fadeInMsg {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}
.ai-message-user {
    align-self: flex-end;
    flex-direction: row-reverse;
}
.ai-message-assistant {
    align-self: flex-start;
}
.ai-msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #4338ca;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.ai-message-user .ai-msg-avatar {
    background: #0ea5e9;
}
.ai-msg-body {
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.55;
    word-break: break-word;
}
.ai-message-assistant .ai-msg-body {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}
.ai-message-user .ai-msg-body {
    background: linear-gradient(135deg, #4338ca 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(67, 56, 202, 0.2);
}
.ai-msg-body pre {
    background: #0f172a;
    color: #f8fafc;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.8125rem;
    overflow-x: auto;
    margin: 8px 0;
}
.ai-msg-body code {
    background: rgba(0, 0, 0, 0.06);
    color: #c026d3;
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 0.8125rem;
}
.ai-message-user .ai-msg-body code {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Prompt Chips */
.ai-prompt-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}
.ai-chip {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    padding: 5px 11px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
}
.ai-chip:hover {
    background: #e0e7ff;
    color: #4338ca;
    border-color: #a5b4fc;
    transform: translateY(-1px);
}

/* Typing Indicator */
.ai-typing-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px 10px 20px;
    background: #f8fafc;
}
.typing-dots {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}
.typing-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6366f1;
    animation: dotPulse 1.4s infinite ease-in-out both;
}
.typing-dots span:nth-child(1) { animation-delay: -0.32s; }
.typing-dots span:nth-child(2) { animation-delay: -0.16s; }
@keyframes dotPulse {
    0%, 80%, 100% { transform: scale(0.4); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
}

/* Footer / Input */
.ai-chat-footer {
    padding: 12px 16px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
}
.ai-input-container {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    background: #f8fafc;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 6px 8px 6px 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.ai-input-container:focus-within {
    border-color: #4338ca;
    box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.15);
    background: #ffffff;
}
.ai-textarea {
    flex: 1;
    border: none;
    background: transparent;
    outline: none;
    resize: none;
    max-height: 100px;
    font-size: 0.875rem;
    line-height: 1.4;
    padding: 4px 0;
    font-family: inherit;
    color: #1e293b;
}
.ai-send-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, opacity 0.2s;
    flex-shrink: 0;
}
.ai-send-btn:hover {
    transform: scale(1.05);
}
.ai-send-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}
.ai-footer-note {
    font-size: 0.6875rem;
    color: #94a3b8;
    text-align: center;
    margin-top: 6px;
}
.ai-footer-note kbd {
    background: #e2e8f0;
    color: #475569;
    padding: 1px 4px;
    border-radius: 3px;
    font-size: 0.65rem;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var fab = document.getElementById('luminaAiFab');
    var win = document.getElementById('luminaAiChatWindow');
    var closeBtn = document.getElementById('luminaAiCloseBtn');
    var clearBtn = document.getElementById('luminaAiClearBtn');
    var input = document.getElementById('luminaAiInput');
    var sendBtn = document.getElementById('luminaAiSendBtn');
    var messagesContainer = document.getElementById('luminaAiMessages');
    var typing = document.getElementById('luminaAiTyping');

    if (!fab || !win || !input || !sendBtn) return;

    var chatHistory = [];
    var isSending = false;

    // Toggle Chat Window
    function toggleChat(open) {
        if (open === undefined) {
            win.classList.toggle('open');
        } else if (open) {
            win.classList.add('open');
        } else {
            win.classList.remove('open');
        }
        win.setAttribute('aria-hidden', !win.classList.contains('open'));
        if (win.classList.contains('open')) {
            input.focus();
            scrollToBottom();
        }
    }

    fab.addEventListener('click', function() { toggleChat(true); });
    closeBtn.addEventListener('click', function() { toggleChat(false); });

    // Auto-expand textarea
    input.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 100) + 'px';
    });

    // Enter to Send, Shift+Enter for new line
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    });

    sendBtn.addEventListener('click', function() {
        sendMessage();
    });

    // Handle Quick Prompt Chips
    document.addEventListener('click', function(e) {
        var chip = e.target.closest('.ai-chip');
        if (chip && chip.dataset.prompt) {
            input.value = chip.dataset.prompt;
            sendMessage();
        }
    });

    // Clear Chat
    clearBtn.addEventListener('click', function() {
        if (confirm('Bersihkan percakapan dengan Lumina AI?')) {
            chatHistory = [];
            messagesContainer.innerHTML = '';
            appendAssistantMessage('Percakapan telah dibersihkan. Silakan tanyakan materi atau pertanyaan baru!');
        }
    });

    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function formatMarkdown(text) {
        if (!text) return '';
        var escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        // Code blocks: ```lang\ncode\n```
        escaped = escaped.replace(/```([a-z0-9_-]*)\n([\s\S]*?)```/gi, function(match, lang, code) {
            return '<pre><code>' + code + '</code></pre>';
        });

        // Inline code: `code`
        escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');

        // Bold: **text**
        escaped = escaped.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        // Bullets: - item
        escaped = escaped.replace(/(?:^|\n)-\s+([^\n]+)/g, '<br>• $1');

        // Numbered list: 1. item
        escaped = escaped.replace(/(?:^|\n)(\d+)\.\s+([^\n]+)/g, '<br>$1. $2');

        // Line breaks
        escaped = escaped.replace(/\n/g, '<br>');

        return escaped;
    }

    function appendUserMessage(text) {
        var div = document.createElement('div');
        div.className = 'ai-message ai-message-user';
        div.innerHTML = 
            '<div class="ai-msg-avatar"><span class="material-symbols-outlined text-[18px]">person</span></div>' +
            '<div class="ai-msg-body">' + formatMarkdown(text) + '</div>';
        messagesContainer.appendChild(div);
        scrollToBottom();
    }

    function appendAssistantMessage(text) {
        var div = document.createElement('div');
        div.className = 'ai-message ai-message-assistant';
        div.innerHTML = 
            '<div class="ai-msg-avatar"><span class="material-symbols-outlined text-[18px]">smart_toy</span></div>' +
            '<div class="ai-msg-body">' + formatMarkdown(text) + '</div>';
        messagesContainer.appendChild(div);
        scrollToBottom();
    }

    function sendMessage() {
        var text = input.value.trim();
        if (!text || isSending) return;

        isSending = true;
        sendBtn.disabled = true;
        input.value = '';
        input.style.height = 'auto';

        appendUserMessage(text);
        chatHistory.push({ role: 'user', text: text });

        // Show typing
        typing.classList.remove('d-none');
        scrollToBottom();

        // Get sesskey
        var sesskey = (window.M && window.M.cfg && window.M.cfg.sesskey) ? window.M.cfg.sesskey : '';
        // Adjusted URL
        var postUrl = M.cfg.wwwroot + '/local/lumina_ai/chat.php';

        var formData = new URLSearchParams();
        formData.append('message', text);
        formData.append('sesskey', sesskey);
        formData.append('history', JSON.stringify(chatHistory.slice(-8)));

        fetch(postUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: formData.toString()
        })
        .then(function(res) {
            return res.json();
        })
        .then(function(data) {
            typing.classList.add('d-none');
            isSending = false;
            sendBtn.disabled = false;

            if (data && data.reply) {
                appendAssistantMessage(data.reply);
                chatHistory.push({ role: 'model', text: data.reply });
            } else {
                appendAssistantMessage('Maaf, saya sedang mengalami kendala teknis saat memproses respons. Silakan coba lagi.');
            }
        })
        .catch(function(err) {
            typing.classList.add('d-none');
            isSending = false;
            sendBtn.disabled = false;
            appendAssistantMessage('Koneksi terputus atau sesi telah berakhir. Silakan muat ulang halaman atau coba beberapa saat lagi.');
        });
    }
});
</script>
