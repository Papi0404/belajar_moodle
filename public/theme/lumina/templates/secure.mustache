{{!
    Lumina LMS Secure Examination Layout Template (Screen 5 Reference).
}}
{{> theme_lumina/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="lumina-exam-wrapper min-vh-100 d-flex flex-column bg-slate-50" style="background-color: #F8FAFC;">
    {{{ output.standard_top_of_body_html }}}

    <!-- Top Secure Exam Header -->
    <header class="lumina-exam-navbar sticky-top bg-white border-bottom shadow-sm px-4 py-2 d-flex align-items-center justify-content-between" style="min-height: 64px; z-index: 1020;">
        <div class="d-flex align-items-center gap-3">
            <div class="lumina-logo-icon" style="width: 32px; height: 32px; font-size: 16px;">L</div>
            <div>
                <span class="fw-bold text-dark fs-6">{{sitename}}</span>
                <span class="badge rounded-pill bg-indigo-50 text-primary border border-indigo-100 ms-2 px-2 py-1" style="font-size: 0.75rem; background-color: #EEF2FF; color: #4338CA;">
                    <span class="lumina-status-dot me-1"></span>Examination Mode
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div id="luminaExamTimerPill" class="d-none d-md-flex align-items-center gap-2 px-3 py-1 bg-light border rounded-pill text-dark fw-medium" style="font-size: 0.875rem;">
                <span class="material-symbols-outlined text-primary" style="font-size: 18px;">timer</span>
                <span id="quiz-timer-display">Assessment Session</span>
            </div>
            {{#output.secure_layout_login_info}}
                <div class="small text-muted border-start ps-3">
                    {{{output.secure_layout_login_info}}}
                </div>
            {{/output.secure_layout_login_info}}
        </div>
    </header>

    <!-- Exam Content Area -->
    <div id="page" class="container-fluid flex-grow-1 px-3 px-md-5 py-4">
        <div id="page-header" class="mb-3">
            <div class="page-context-header">
                <div class="page-header-headings">
                    {{{ output.page_heading }}}
                </div>
            </div>
        </div>

        <div id="page-content" class="row g-4">
            <!-- Main Question Stream -->
            <div id="region-main-box" class="{{#hasblocks}}col-lg-9 col-12{{/hasblocks}}{{^hasblocks}}col-12{{/hasblocks}}">
                <div id="region-main" class="bg-white rounded-3 p-4 shadow-sm border {{#hasblocks}}has-blocks{{/hasblocks}}">
                    {{{ output.course_content_header }}}
                    {{#headercontent}}
                        {{> core/activity_header }}
                    {{/headercontent}}
                    {{{ output.main_content }}}
                    {{{ output.course_content_footer }}}
                </div>
            </div>

            <!-- Quiz Navigation & Block Matrix -->
            {{#hasblocks}}
                <div class="col-lg-3 col-12 d-print-none" data-region="blocks-column">
                    <div class="sticky-top" style="top: 80px;">
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                            <div class="card-header bg-white border-bottom py-3 px-3 d-flex align-items-center justify-content-between">
                                <span class="fw-semibold text-dark d-flex align-items-center gap-2" style="font-size: 0.875rem;">
                                    <span class="material-symbols-outlined text-primary" style="font-size: 20px;">grid_view</span>
                                    Question Matrix
                                </span>
                            </div>
                            <div class="card-body p-3">
                                {{{ sidepreblocks }}}
                            </div>
                        </div>
                    </div>
                </div>
            {{/hasblocks}}
        </div>
    </div>

    <!-- Exam Footer -->
    <footer id="page-footer" class="py-3 bg-white border-top text-center text-muted small mt-auto">
        <div class="container-fluid">
            <div>{{{ output.course_footer }}}</div>
            <div class="d-flex justify-content-center align-items-center gap-3 text-muted">
                <span>&copy; 2026 Lumina LMS Safe Assessment Environment</span>
                <span>•</span>
                <span>All actions and submissions are encrypted & timestamped</span>
            </div>
            {{{ output.standard_end_of_body_html }}}
        </div>
    </footer>
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
{{/js}}

