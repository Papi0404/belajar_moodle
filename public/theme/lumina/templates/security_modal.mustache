{{!
    Lumina LMS Security & Up-to-date Center Modal.
}}
<div class="modal fade lumina-security-modal" id="luminaSecurityModal" tabindex="-1" aria-labelledby="luminaSecurityModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0" style="border-radius: var(--lumina-radius-lg, 16px); overflow: hidden;">
            
            <!-- Modal Header -->
            <div class="modal-header text-white" style="background: linear-gradient(135deg, var(--lumina-primary, #4338CA) 0%, #6366F1 55%, #818CF8 100%); border-bottom: none; padding: 1.5rem 1.75rem;">
                <div class="d-flex align-items-center gap-3">
                    <div style="background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.35); border-radius: 12px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
                        <span class="material-symbols-outlined text-white" style="font-size: 24px;">verified_user</span>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0 text-white" id="luminaSecurityModalLabel" style="font-family: var(--lumina-font-display, inherit); font-size: 1.25rem;">Pusat Keamanan & Pembaruan Sistem</h5>
                        <p class="mb-0 text-white-50 small">Monitoring real-time enkripsi, autentikasi, integritas platform, dan isolasi plugin</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4" style="background: var(--lumina-surface, #F8FAFC);">

                <!-- Overall Health Score Card -->
                <div class="card border-0 mb-4 shadow-xs" style="border-radius: 14px; background: #FFFFFF; border: 1px solid var(--lumina-border, #E2E8F0) !important;">
                    <div class="card-body p-3 p-md-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="position-relative d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(16, 185, 129, 0.12); border: 2px solid rgba(16, 185, 129, 0.3);">
                                    <span class="fw-bold text-success fs-4">{{ lumina_security.score }}%</span>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">{{ lumina_security.status_text }}</h6>
                                        <span class="badge rounded-pill bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-1 font-semibold" style="font-size: 0.72rem;">Optimal</span>
                                    </div>
                                    <div class="text-muted small">Audit terakhir: <strong>{{ lumina_security.last_checked }}</strong></div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-medium" style="font-size: 0.8rem;">
                                    Moodle {{ lumina_security.moodle_version }}
                                </span>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-semibold" style="font-size: 0.8rem;">
                                    PHP {{ lumina_security.php_version }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Plugin Isolation Notice Banner -->
                <div class="alert alert-primary d-flex align-items-start gap-3 mb-4 border-0 shadow-xs" style="border-radius: 12px; background: rgba(67, 56, 202, 0.08); border-left: 4px solid var(--lumina-primary, #4338CA) !important;">
                    <span class="material-symbols-outlined text-primary mt-1" style="font-size: 22px;">shield_lock</span>
                    <div class="small text-dark">
                        <div class="fw-bold text-primary mb-1">Proteksi Pembaruan Moodle (Plugin Independence)</div>
                        Tema Lumina berjalan 100% mandiri sebagai Moodle theme plugin di <code>theme/lumina/</code>. Jika Moodle diperbarui (versi core atau patch keamanan), seluruh modul, tampilan UI/UX, dan data Anda tetap terlindungi tanpa risiko tertimpa.
                    </div>
                </div>

                <!-- Security Checklist Grid -->
                <h6 class="fw-bold text-dark mb-3" style="font-size: 0.95rem;">Parameter Keamanan Real-Time:</h6>
                <div class="row g-3">
                    {{#lumina_security.items}}
                    <div class="col-md-6">
                        <div class="card h-100 border-0 p-3 shadow-xs" style="border-radius: 12px; background: #FFFFFF; border: 1px solid var(--lumina-border, #E2E8F0) !important;">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="material-symbols-outlined {{ icon_class }}" style="font-size: 20px;">{{ icon }}</span>
                                    <span class="fw-semibold text-dark small">{{ title }}</span>
                                </div>
                                <span class="badge rounded-pill bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-0-5 font-semibold" style="font-size: 0.68rem;">
                                    {{ badge }}
                                </span>
                            </div>
                            <p class="text-muted mb-0" style="font-size: 0.8rem; line-height: 1.4;">{{ description }}</p>
                        </div>
                    </div>
                    {{/lumina_security.items}}
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer d-flex justify-content-between align-items-center p-3" style="background: #FFFFFF; border-top: 1px solid var(--lumina-border, #E2E8F0);">
                <div class="text-muted small">
                    <span class="material-symbols-outlined text-success" style="font-size: 14px; vertical-align: -2px;">check_circle</span>
                    Status Keamanan Aktif & Up-to-date
                </div>
                <div class="d-flex align-items-center gap-2">
                    {{#lumina_security.is_admin}}
                    <a href="{{{ lumina_security.security_report_url }}}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1-5 fw-medium" target="_blank">
                        <span class="material-symbols-outlined" style="font-size: 16px; vertical-align: -3px; margin-right: 2px;">open_in_new</span>
                        Audit Keamanan Moodle
                    </a>
                    {{/lumina_security.is_admin}}
                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-4 py-1-5 fw-semibold" data-bs-dismiss="modal">
                        Tutup
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

